# akh-bot environment template — copy to .env and fill in. NEVER commit .env.

APP_ENV=production
DATA_DIR=/data
LOG_LEVEL=INFO

# --- Admin ---
ADMIN_USERNAME=admin
# Either set a plaintext password (server-local .env, chmod 600) ...
ADMIN_PASSWORD=
# ... or preferably a scrypt hash. Generate with:
#   python -m app.core.security make-hash <password>
ADMIN_PASSWORD_HASH=
# Long random string (required). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_HOURS=12

# --- Brand (see config/brand.yml; BRAND_STATUS stays UNDECIDED until owner approves) ---
BRAND_CONFIG=config/brand.yml
# Empty until the public domain exists. Empty = preview mode (robots disallow, no canonical).
PUBLIC_BASE_URL=

# --- LLM (Z.ai / GLM, OpenAI-compatible) ---
LLM_PROVIDER=glm
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# Confirm the model enabled on the owner's account before first use (verify with
# scripts/verify_integrations.py — it records model/HTTP/latency only).
GLM_MODEL=glm-4.6
LLM_TIMEOUT_SECONDS=90

# --- Telegram publishing (Bot API, staging/private channel until brand approved) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAGING_CHAT_ID=

# --- Telegram ingestion (Telethon, dedicated listener account) ---
TELEGRAM_INGEST_API_ID=
TELEGRAM_INGEST_API_HASH=
TELEGRAM_INGEST_SESSION=

# --- Workers / cadence ---
WORKERS_ENABLED=true
INGEST_INTERVAL_SECONDS=300
PIPELINE_INTERVAL_SECONDS=60
JOBS_INTERVAL_SECONDS=10

# --- Publishing rate limits ---
MAX_POSTS_PER_HOUR=60
MAX_POSTS_PER_DAY=500

# --- P3-D: per-source context + burst aggregation (wired by P3-E; V2 stays off) ---
# Context from a CONTEXT_ONLY prefix («ترامپ به مجله تایم:») lives this long,
# per source only, and never crosses sources.
SOURCE_CONTEXT_TTL_SECONDS=1800
# Short window that groups rapidly arriving fragments of the same story before
# publication logic (P3-E). NOT the per-event-type continuation window.
EVENT_BURST_WINDOW_SECONDS=180

[Unit]
Description=Rasteh scoped five-day retention
Documentation=file:///opt/akhbot/app/docs/HOST-DISK-RETENTION.md
After=local-fs.target docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Nice=19
IOSchedulingClass=idle
CPUQuota=40%
TimeoutStartSec=15min
ExecStart=/usr/bin/python3 /usr/local/sbin/rasteh-host-disk-retention.py --apply
StandardOutput=journal
StandardError=journal
